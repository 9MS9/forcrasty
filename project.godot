; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="WEAREFEW"
run/main_scene="uid://cr5yyjcsgqbsk"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[debug_draw_3d]

settings/addon_root_folder="res://debug_draw_3d-1.7.3/addons/debug_draw_3d"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="environment"
3d_physics/layer_2="mech"

[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/velocity_steps=16
jolt_physics_3d/simulation/position_steps=4
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"
